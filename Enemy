_G.GetWorldsList = function()
    local worlds = {}
    for _, child in ipairs(workspace:GetChildren()) do
        if child.Name:match("^World%d+$") then
            table.insert(worlds, child.Name)
        end
    end
    table.sort(worlds, function(a, b)
        return (tonumber(a:match("%d+")) or 0) < (tonumber(b:match("%d+")) or 0)
    end)
    return worlds
end

_G.isInRaid = function()
    for _, worldName in ipairs(_G.GetWorldsList()) do
        local world = workspace:FindFirstChild(worldName)
        if world and world:FindFirstChild("Map") then
            return false
        end
    end
    return true
end

