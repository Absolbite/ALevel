local RaritiesWeakToStrong = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical"}
local RaritiesStrongToWeak = {"Mythical", "Legendary", "Epic", "Rare", "Uncommon", "Common"}

local function isEnemyAliveQuest(mob)
    if not mob or not mob.Parent then return false end
    if mob:GetAttribute("Attackable") == false then return false end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    return mob:FindFirstChild("HumanoidRootPart") ~= nil
end

local function NormalizeName(name)
    if not name then return "" end
    return name:gsub("_", " "):lower():match("^%s*(.-)%s*$")
end

local function IsQuestIncomplete(amountText)
    if not amountText or amountText == "" then return false end
    local current, max = amountText:match("(%d+)/(%d+)")
    if current and max then
        return tonumber(current) < tonumber(max)
    end
    return false
end

local function GetActiveQuestMob(worldName)
    local playerGui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local questGui = playerGui.Main.Frames:FindFirstChild(worldName .. "Quest")
    if not (questGui and questGui:FindFirstChild("Container") and questGui.Container:FindFirstChild("Frame")) then
        return nil
    end
    local framesContainer = questGui.Container.Frame
    local rarities = _G.QuestPriority == "Strong To Weak" and RaritiesStrongToWeak or RaritiesWeakToStrong

    for _, rarity in ipairs(rarities) do
        local rarityFrame = framesContainer:FindFirstChild(rarity)
        if rarityFrame and rarityFrame:FindFirstChild("Unit") then
            local unit = rarityFrame.Unit
            local amountLabel = unit:FindFirstChild("Amount")
            local nameLabel   = unit:FindFirstChild("Name")
            if amountLabel and nameLabel then
                local amountText = amountLabel.Text:gsub("<[^>]+>", "")
                local mobName    = nameLabel.Text:gsub("<[^>]+>", "")
                if IsQuestIncomplete(amountText) then
                    return mobName
                end
            end
        end
    end
    return nil
end

local function CreateAutoQuestLoop()
    task.spawn(function()
        while _G.AutoQuest do
            local worldName = _G.QuestWorld

            pcall(function()
                local qGui = game:GetService("Players").LocalPlayer.PlayerGui.Main.Frames:FindFirstChild(worldName .. "Quest")
                if qGui and not qGui.Visible then qGui.Visible = true end
            end)

            if not _G.IsInWorld(worldName) then task.wait(0.5); continue end

            local targetMobName = GetActiveQuestMob(worldName)
            if not targetMobName then task.wait(0.5); continue end

            local targetNorm  = NormalizeName(targetMobName)
            local hrp         = _G.GetRoot()
            local world       = workspace:FindFirstChild(worldName)
            local enemyFolder = world and world:FindFirstChild("Enemy")

            if hrp and enemyFolder then
                local targetMob = nil
                local minDist = math.huge

                for _, mob in ipairs(enemyFolder:GetChildren()) do
                    if NormalizeName(mob.Name) == targetNorm and isEnemyAliveQuest(mob) then
                        local mHrp = mob:FindFirstChild("HumanoidRootPart")
                        if mHrp then
                            local dist = (hrp.Position - mHrp.Position).Magnitude
                            if dist < minDist then
                                minDist = dist
                                targetMob = mob
                            end
                        end
                    end
                end

                if targetMob then
                    while _G.AutoQuest and isEnemyAliveQuest(targetMob) and NormalizeName(GetActiveQuestMob(_G.QuestWorld)) == targetNorm do
                        local curHrp = _G.GetRoot()
                        if curHrp and targetMob:FindFirstChild("HumanoidRootPart") then
                            curHrp.CFrame = targetMob.HumanoidRootPart.CFrame
                        end
                        task.wait()
                    end
                else
                    task.wait(0.1)
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

