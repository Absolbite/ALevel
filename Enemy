local function createV2Loop(worldName)
    _G.createFastTp(
        function() return _G.V2.AutoTP[worldName] end,
        function()
            if not _G.IsInWorld(worldName) then return nil end

            local hrp = _G.GetRoot()
            local world = workspace:FindFirstChild(worldName)
            local enemyFolder = world and world:FindFirstChild("Enemy")
            if not hrp or not enemyFolder then return nil end

            local selectedEnemies = _G.V2.SelectedEnemies[worldName] or {}
            local targets = {}
            for _, mob in pairs(enemyFolder:GetChildren()) do
                local selected = selectedEnemies[mob.Name] == true or (type(selectedEnemies) == "table" and table.find(selectedEnemies, mob.Name))
                if mob:IsA("Model") and selected and isEnemyAlive(mob) then
                    local tHrp = mob:FindFirstChild("HumanoidRootPart")
                    if tHrp then
                        table.insert(targets, {
                            Instance = mob,
                            HRP      = tHrp,
                            Distance = (hrp.Position - tHrp.Position).Magnitude,
                            HP       = parseHPValue(mob),
                        })
                    end
                end
            end

            return selectTarget(targets, _G.V2.GlobalPriority)
        end
    )
end

