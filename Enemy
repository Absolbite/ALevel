local function isInRaid()
    local ok, result = pcall(function()
        local waveFrame = game:GetService("Players").LocalPlayer.PlayerGui.Main.HUD.Dungeon.RaidsInfo.WavesFrame.Wave
        local text = waveFrame.ContentText
        if not text or text == "" then text = waveFrame.Text or "0/0" end
        local _, max = text:match("^(%d+)/(%d+)$")
        return tonumber(max) and tonumber(max) > 0
    end)
    return ok and result
end

local function getCurrentWave()
    local ok, result = pcall(function()
        local waveFrame = game:GetService("Players").LocalPlayer.PlayerGui.Main.HUD.Dungeon.RaidsInfo.WavesFrame.Wave
        local text = waveFrame.ContentText
        if not text or text == "" then text = waveFrame.Text or "0/0" end
        return tonumber(text:match("^(%d+)/")) or 0
    end)
    return ok and result or 0
end

