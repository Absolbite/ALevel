task.spawn(function()
    while true do
        task.wait(1)
        if _G.AutoTP and not _G.EnemyLoopRunning then
            _G.EnemyLoopRunning = true
            task.spawn(function()
                _G.createWorldAutoTPLoop(function() return _G.AutoTP end)
                _G.EnemyLoopRunning = false
            end)
        end
        for _, wn in ipairs(_G.WorldList) do
            if _G.V2.AutoTP[wn] and not _G.V2.LoopRunning[wn] then
                _G.V2.LoopRunning[wn] = true
                local _w = wn
                task.spawn(function()
                    createV2Loop(_w)
                    _G.V2.LoopRunning[_w] = false
                end)
            end
        end
    end
end)

