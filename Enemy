_G.GetRoot = function()
    local player = game.Players.LocalPlayer
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function parseHPValue(mob)
    local val = 0
    pcall(function()
        local hpLabel = mob:FindFirstChild("Head") and mob.Head:FindFirstChild("BillboardGui") and mob.Head.BillboardGui.Holder.Health.Bar.HP
        if not hpLabel then return end
        local text = hpLabel.ContentText ~= "" and hpLabel.ContentText or hpLabel.Text
        local raw = string.split(text, "|")[1]
        if raw then
            local num    = tonumber(string.match(raw:gsub(";", ""), "[%d%.]+")) or 0
            local suffix = string.match(raw, "%a+")
            val = (suffix and suffixMultipliers[suffix]) and (num * suffixMultipliers[suffix]) or num
        end
    end)
    return val
end

local function isEnemyAlive(mob)
    if not mob or not mob.Parent then return false end
    local val = mob:GetAttribute("Attackable")
    warn("Attackable =", val, type(val))
    if val ~= true then return false end
    return true
end

local function isRaidEnemyAlive(mob)
    if not mob or not mob.Parent then return false end
    if mob:GetAttribute("Attackable") ~= true then return false end
    return mob:FindFirstChild("HumanoidRootPart") ~= nil
end

_G.GetEnemiesList = function(worldName)
    local list, hash = {}, {}
    local world = workspace:FindFirstChild(worldName)
    if world and world:FindFirstChild("Enemy") then
        for _, mob in pairs(world.Enemy:GetChildren()) do
            if mob:IsA("Model") and not hash[mob.Name] then
                table.insert(list, mob.Name)
                hash[mob.Name] = true
            end
        end
    end
    return list
end

local function selectTarget(targets, priority)
    if #targets == 0 then return nil end
    if priority == "Nearest" then
        table.sort(targets, function(a, b) return a.Distance < b.Distance end)
    elseif priority == "Weak To Strong" then
        table.sort(targets, function(a, b) return a.HP < b.HP end)
    elseif priority == "Strong To Weak" then
        table.sort(targets, function(a, b) return a.HP > b.HP end)
    elseif priority == "Random" then
        return targets[math.random(1, #targets)]
    end
    return targets[1]
end

_G.createFastTp = function(flagFunc, getTargetFunc)
    local currentMob = nil
    while flagFunc() do
        if _G.isInRaid() then
            currentMob = nil
            task.wait(1)
            continue
        end

        if currentMob and currentMob.Parent and currentMob:GetAttribute("Attackable") == true then
            local tHrp = currentMob:FindFirstChild("HumanoidRootPart")
            local curHrp = _G.GetRoot()
            if tHrp and curHrp then
                pcall(function() curHrp.CFrame = tHrp.CFrame end)
            end
            task.wait()
            continue
        end

        currentMob = nil
        local targetData = getTargetFunc()
        if not targetData then
            task.wait(0.1)
            continue
        end

        local candidate = targetData.Instance
        if not candidate or not candidate.Parent or candidate:GetAttribute("Attackable") ~= true then
            task.wait(0.1)
            continue
        end

        currentMob = candidate
        local curHrp = _G.GetRoot()
        if curHrp and targetData.HRP then
            pcall(function() curHrp.CFrame = targetData.HRP.CFrame end)
        end
        task.wait()
    end
end

local function createRaidFastTp(flagFunc, getTargetFunc)
    task.spawn(function()
        local currentMob = nil
        while flagFunc() do
            if currentMob and isRaidEnemyAlive(currentMob) then
                local tHrp = currentMob:FindFirstChild("HumanoidRootPart")
                local curHrp = _G.GetRoot()
                if tHrp and curHrp then
                    pcall(function() curHrp.CFrame = tHrp.CFrame end)
                end
                task.wait()
                continue
            end

            currentMob = nil
            local targetData = getTargetFunc()
            if not targetData then
                task.wait(0.1)
                continue
            end
            currentMob = targetData.Instance
            local curHrp = _G.GetRoot()
            if curHrp and targetData.HRP then
                pcall(function() curHrp.CFrame = targetData.HRP.CFrame end)
            end
            task.wait()
        end
    end)
end

_G.createWorldAutoTPLoop = function(flagFunc)
    _G.createFastTp(flagFunc, function()
        if not _G.IsInWorld(_G.SelectedWorld) then return nil end

        local hrp = _G.GetRoot()
        local world = workspace:FindFirstChild(_G.SelectedWorld)
        local enemyFolder = world and world:FindFirstChild("Enemy")
        if not hrp or not enemyFolder then return nil end

        local targets = {}
        for _, mob in pairs(enemyFolder:GetChildren()) do
            local selected = _G.SelectedEnemies[mob.Name] == true or (type(_G.SelectedEnemies) == "table" and table.find(_G.SelectedEnemies, mob.Name))
            if mob:IsA("Model") and selected and isEnemyAlive(mob) then
                local tHrp = mob:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    table.insert(targets, {
                        HRP      = tHrp,
                        Instance = mob,
                        Distance = (hrp.Position - tHrp.Position).Magnitude,
                        HP       = parseHPValue(mob),
                    })
                end
            end
        end

        return selectTarget(targets, _G.SelectedPriority)
    end)
end

